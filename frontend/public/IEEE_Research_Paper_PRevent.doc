            <line x1="377" y1="144" x2="422" y2="64" stroke="#3730a3" stroke-width="1.2"/>
            <line x1="377" y1="144" x2="422" y2="120" stroke="#3730a3" stroke-width="1.2"/>
            <line x1="377" y1="212" x2="422" y2="176" stroke="#3730a3" stroke-width="1.2"/>
            <line x1="517" y1="198" x2="517" y2="210" stroke="#3730a3" stroke-width="1.2"/>
